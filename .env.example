# Database
DATABASE_URL=sqlite:///./agent_factory.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_factory

# Redis (for RQ background jobs)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# LLM Providers (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_LLM=gpt-4o-mini
# Options: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022

# Search Providers (at least one required)
BING_SEARCH_API_KEY=
SERPAPI_KEY=
SEARCH_PROVIDER=bing
# Options: bing, serpapi

# GitHub Integration (optional)
GITHUB_TOKEN=ghp_...

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@agent-factory.com

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Application Settings
ENVIRONMENT=development
# Options: development, production

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# Research Settings
MAX_RESEARCH_SOURCES=50
MAX_CRAWL_TIMEOUT=30
RESEARCH_CONTENT_LIMIT=100000

# Agent Execution
MAX_AGENT_RUNTIME=3600
ENABLE_APPROVALS=true

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Agent Factory

# Playwright
PLAYWRIGHT_HEADLESS=true
